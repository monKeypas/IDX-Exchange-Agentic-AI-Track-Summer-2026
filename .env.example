# Copy to .env at the project root:  cp .env.example .env
# .env is gitignored — never commit real credentials.

# --- MySQL (Weeks 3-7, 9-11) ---------------------------------------------
# Required by every DB-backed script: search:mls, chat, market, embed:build,
# search:semantic, recommend, orchestrate, email:draft.
# Tables used: rets_property (active listings), california_sold (comps/stats).
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=idx_exchange

# --- Embeddings (Week 6-7) -----------------------------------------------
# "local" (default) runs MiniLM on-device with no API quota.
# "gemini" uses gemini-embedding-001 and needs a key below.
# Switching providers changes vector dimensions (384 <-> 768) and requires a
# full `npm run embed:build` rebuild — the cache fails fast on mismatch.
EMBEDDING_PROVIDER=local

# Only needed for EMBEDDING_PROVIDER=gemini or RAG generative answers.
# Falls back to ~/.openclaw/openclaw.json (plugins.entries.google) if unset.
# GEMINI_API_KEY=

# --- Email agent (Week 11) -----------------------------------------------
# Only needed for `npm run email:send`. Drafting and preview work without it.
# Gmail requires an App Password, not your account password.
# EMAIL_USER=you@gmail.com
# EMAIL_PASSWORD=

# --- Optional overrides ---------------------------------------------------
# CHAT_USER_ID=alice                  # default --user for npm run chat
# RAG_INDEX_PATH=                     # default: skills/rag/.index/chunks.json
# SEMANTIC_EMBEDDINGS_PATH=           # default: skills/semantic-search/.embeddings/
# RAG_CHAT_MODEL=                     # generative model for RAG answers
